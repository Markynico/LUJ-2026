[ext_resource type="Texture2D" uid="uid://bhi3nf0jngdpb" path="res://assets/tapir.jpg" id="3_fondo"]

[node name="PantallaStats" type="Control" node_paths=PackedStringArray("label_titulo", "contenedor_stats", "contenedor_reliquias", "boton_volver")]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_tema")
script = ExtResource("1_stats")
