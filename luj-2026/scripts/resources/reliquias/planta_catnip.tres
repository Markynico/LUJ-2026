[sub_resource type="Resource" id="CondicionDesbloqueo_1"]
script = ExtResource("1_cond")
contador = "ovillos_rotos_de_tipo"
cantidad = 10
ovillo_objetivo = ExtResource("3_rel")

[sub_resource type="Resource" id="Efecto_1"]
script = ExtResource("e_multiplicador")
que = 2
multiplicador = 1.25
tipos_objetivo = Array[ExtResource("4_rel")]([ExtResource("3_rel")])

[resource]
script = ExtResource("1_rel")
nombre = "Planta de Catnip"
descripcion = "Más de probabilidad de que aparezcan  {catnip:icono}

\"No dura ni una semana\""
icono = ExtResource("2_rel")
efectos = Array[ExtResource("3_e2vcf")]([SubResource("Efecto_1")])
condiciones_desbloqueo = Array[ExtResource("1_cond")]([SubResource("CondicionDesbloqueo_1")])
