[gd_resource type="Resource" script_class="Reliquia" format=3 uid="uid://jj15nhwfreho"]

[ext_resource type="Script" uid="uid://bus0kgj1moqjc" path="res://scripts/condicion_desbloqueo.gd" id="1_cond"]
[ext_resource type="Script" uid="uid://5lbsfhx8xug1" path="res://scripts/reliquias/reliquia.gd" id="1_rel"]
[ext_resource type="Texture2D" uid="uid://cvsvsfqjfm6t5" path="res://assets/reliquias/balanceado whiskas.png" id="2_rel"]
[ext_resource type="Script" uid="uid://c6f3ybcbnyfng" path="res://scripts/reliquias/efecto_reliquia.gd" id="2_shajs"]
[ext_resource type="Script" uid="uid://bvhxnhetlks4x" path="res://scripts/reliquias/efectos/efecto_disparo.gd" id="e_disparo"]
[ext_resource type="Script" uid="uid://dvuyv3xng8oje" path="res://scripts/reliquias/efectos/efecto_slots_vida.gd" id="e_slots"]

[sub_resource type="Resource" id="CondicionDesbloqueo_1"]
script = ExtResource("1_cond")
contador = "niveles_perdidos"
cantidad = 5

[sub_resource type="Resource" id="Efecto_1"]
script = ExtResource("e_slots")
slots = -1

[sub_resource type="Resource" id="Efecto_2"]
script = ExtResource("e_disparo")
multiplicador_velocidad = 1.25

[resource]
script = ExtResource("1_rel")
nombre = "Bolsa de Balanceado Whiskas"
descripcion = "-1 {slot_vida:icono} máximo.
+25% {velocidad:texto/velocidad} de disparo.

\"Por favor no le compres esta mierda a tu gato.\""
icono = ExtResource("2_rel")
efectos = Array[ExtResource("2_shajs")]([SubResource("Efecto_1"), SubResource("Efecto_2")])
condiciones_desbloqueo = Array[ExtResource("1_cond")]([SubResource("CondicionDesbloqueo_1")])
