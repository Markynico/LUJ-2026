[sub_resource type="Resource" id="CondicionDesbloqueo_1"]
script = ExtResource("1_cond")
contador = "runs_ganadas_en_dificultad"
dificultad_objetivo = ExtResource("1_8sfuv")

[sub_resource type="Resource" id="Efecto_1"]
script = ExtResource("e_multiplicador")

[sub_resource type="Resource" id="Efecto_2"]
script = ExtResource("e_acc_curar")
vidas = -1

[sub_resource type="Resource" id="Efecto_3"]
script = ExtResource("e_enhook")
probabilidad = 1.0
acciones = Array[ExtResource("e_acc_base")]([SubResource("Efecto_2")])
hook = "al_disparar"

[resource]
script = ExtResource("1_rel")
nombre = "Vasija a Punto de Caerse"
rareza = 3
descripcion = "Todos los ovillos dan el doble de puntos. Hay una pequeña probabilidad de recibir 1 {vida:icono} de daño por disparo.

\"Me parece que las cenizas de la abuela estaban acá...\""
icono = ExtResource("2_rel")
efectos = Array[ExtResource("3_m3b1f")]([SubResource("Efecto_1"), SubResource("Efecto_3")])
condiciones_desbloqueo = Array[ExtResource("1_cond")]([SubResource("CondicionDesbloqueo_1")])
